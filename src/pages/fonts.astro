---
import BaseLayout from '../layouts/BaseLayout.astro';

const samples = [
  { name: 'Onest', fam: 'Onest', desc: 'Гуманистический гротеск с отличной кириллицей: тёплый, не дежурный.' },
  { name: 'Manrope', fam: 'Manrope', desc: 'Мягкая геометрия, хорош в цифрах и мелких UI-подписях.' },
  { name: 'Golos Text', fam: 'Golos Text', desc: 'Русская классика: грамотная кириллица, аккуратная плотность.' },
  { name: 'Geologica', fam: 'Geologica', desc: 'Вариативный, свежая широкая кириллица, не кричит.' },
  { name: 'Unbounded (только заголовки)', fam: 'Unbounded', desc: 'Характерный акцидентный — для заголовков, ниже обычный текст для контраста.' },
  { name: 'Space Grotesk (текущий)', fam: 'Space Grotesk', desc: 'Текущий: кириллицы нет вообще — на русском работает fallback. Для сравнения.' },
];
---

<BaseLayout
  lang="ru"
  title="Выбор шрифта"
  pagePath="/fonts"
  description="Черновая страница для сравнения шрифтов."
>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Onest:wght@300;400;800&family=Manrope:wght@300;400;800&family=Golos+Text:wght@300;400;800&family=Geologica:wght@300;400;800&family=Unbounded:wght@300;400;800&display=swap"
  />
  <section class="section">
    <div class="container">
      <p class="font-note">Черновик · после выбора шрифта страница удалится</p>
      {samples.map((f) => (
        <div class="font-sample">
          <h2 class="font-sample__name">{f.name}</h2>
          <p class="font-sample__desc">{f.desc}</p>
          <p class="font-sample__line" style={`font-family: '${f.fam}', sans-serif; font-weight: 800;`}>
            Групповой полёт UUEE → EHAM
          </p>
          <p class="font-sample__line" style={`font-family: '${f.fam}', sans-serif; font-weight: 400;`}>
            Сообщество пилотов VATSIM: совместные полёты, обучение новичков и живое
            комьюнити. 0123456789 · Абакан-Товер, борт RA-64012.
          </p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .font-note {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .font-sample {
    padding: 1.4rem 0;
    border-top: 1px solid var(--border);
  }
  .font-sample__name {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--accent);
    margin: 0 0 0.2rem;
  }
  .font-sample__desc {
    font-size: 0.85rem;
    color: var(--text-2);
    margin: 0 0 1rem;
    max-width: 46rem;
  }
  .font-sample__line {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.5;
  }
</style>
