---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventsView from '../views/Events.astro';
import { dicts } from '../i18n';

const lang = 'ru' as const;
const dict = dicts[lang];
---
<BaseLayout lang={lang} title={dict.events.title} pagePath="/events">
  <EventsView lang={lang} />
</BaseLayout>
