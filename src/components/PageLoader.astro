---
/**
 * Full-screen page loader in "departure board" style:
 * brand logo, "please wait" line and a little plane easing across a cloud.
 * Hidden by BaseLayout's inline script once the page has loaded.
 */
import { asset } from '../utils/links';

interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div id="page-loader" class="page-loader" role="status" aria-live="polite">
  <div class="page-loader__inner">
    <div class="page-loader__brand">
      <img
        class="page-loader__logo"
        src={asset('/assets/logo-skn.png')}
        alt=""
        width="72"
        height="72"
      />
      <span class="page-loader__wordmark">Sky<span>National</span></span>
    </div>

    <p class="page-loader__text">{text}</p>

    <div class="page-loader__scene" aria-hidden="true">
      <svg class="page-loader__cloud" width="46" height="24" viewBox="0 0 46 24" fill="none">
        <path
          d="M12 22C7 22 3.5 19 3.5 15.2 3.5 11.6 6.6 9 10.6 9 11.6 4.9 15.3 2 20 2c5.3 0 9.6 3.8 10.2 8.7 6.7.3 12 3 12 6.5 0 2.7-3.2 4.8-7.4 4.8H12Z"
          fill="currentColor"
          opacity="0.55"></path>
      </svg>
      <svg class="page-loader__plane" width="34" height="34" viewBox="0 0 24 24" fill="none">
        <path
          d="M21 16v-2l-8-5V3.5C13 2.67 12.33 2 11.5 2S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
          fill="currentColor"
          transform="rotate(90 12 12)"></path>
      </svg>
    </div>
  </div>
</div>

<style>
  .page-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    background: var(--bg);
    opacity: 1;
    transition:
      opacity 0.45s ease,
      visibility 0.45s ease;
  }

  .page-loader__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
    text-align: center;
    padding: 2rem;
  }

  .page-loader__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
  }

  .page-loader__logo {
    width: 72px;
    height: 72px;
    object-fit: contain;
    animation: loader-in 0.6s ease both;
  }

  .page-loader__wordmark {
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: 0.02em;
    color: var(--accent);
    animation: loader-in 0.6s 0.08s ease both;
  }

  .page-loader__wordmark span {
    color: var(--text);
  }

  [data-theme='dark'] .page-loader__wordmark span,
  [data-theme='dark'] .page-loader__wordmark {
    color: var(--accent);
  }

  [data-theme='dark'] .page-loader__wordmark span {
    color: var(--text);
  }

  .page-loader__text {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    animation: loader-in 0.6s 0.16s ease both;
  }

  /* Plane glides left to right beneath a slowly drifting cloud. */
  .page-loader__scene {
    position: relative;
    width: 240px;
    height: 44px;
    overflow: visible;
    animation: loader-in 0.6s 0.24s ease both;
  }

  .page-loader__cloud {
    position: absolute;
    left: 88px;
    bottom: 18px;
    color: var(--muted);
    animation: cloud-drift 6s ease-in-out infinite alternate;
  }

  .page-loader__plane {
    position: absolute;
    left: 0;
    bottom: 12px;
    color: var(--text-2);
    animation: plane-fly 2.8s ease-in-out infinite;
  }

  @keyframes plane-fly {
    0% {
      transform: translateX(-36px) translateY(4px);
      opacity: 0;
    }
    18% {
      opacity: 1;
    }
    50% {
      transform: translateX(112px) translateY(-3px);
    }
    82% {
      opacity: 1;
    }
    100% {
      transform: translateX(244px) translateY(2px);
      opacity: 0;
    }
  }

  @keyframes cloud-drift {
    from {
      transform: translateX(-6px);
    }
    to {
      transform: translateX(10px);
    }
  }

  @keyframes loader-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .page-loader--hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-loader__logo,
    .page-loader__wordmark,
    .page-loader__text,
    .page-loader__scene {
      animation: none;
    }
    .page-loader__plane {
      animation: none;
      transform: translateX(112px);
      opacity: 1;
    }
    .page-loader__cloud {
      animation: none;
    }
    .page-loader {
      transition: opacity 0.2s ease;
    }
  }
</style>
