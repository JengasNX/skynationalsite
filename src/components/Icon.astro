---
/** Small stroke icon set (Feather-style, 24×24, currentColor). */
interface Props {
  name:
    | 'search'
    | 'sun'
    | 'moon'
    | 'globe'
    | 'menu'
    | 'close'
    | 'plane'
    | 'calendar'
    | 'clock'
    | 'pin'
    | 'tag'
    | 'book'
    | 'users'
    | 'shield'
    | 'check'
    | 'external'
    | 'send'
    | 'discord'
    | 'arrow-right'
    | 'info'
    | 'zap';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;

/** Icons that are painted instead of stroked (brand marks). */
