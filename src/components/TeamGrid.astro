---
/**
 * "International team" section in the reference style:
 * small labelled square + eyebrow, huge uppercase heading with an accent arrow,
 * then a row of member cards: photo, name in caps, short bio.
 * Photos come from public/assets/team/<id>.jpg; until they exist a styled
 * fallback with initials is shown.
 */
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';
import { dicts } from '../i18n';
import { asset, type Lang } from '../utils/links';
import { TEAM_MEMBERS } from '../data/team';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = dicts[lang];

const publicRoot = fileURLToPath(new URL('../../public', import.meta.url));
const hasPhoto = (id: string) => fs.existsSync(`${publicRoot}/assets/team/${id}.jpg`);

const initialsOf = (name: string) =>
  name
    .replace(/[^\p{L}\p{N}\s]/gu, '')
    .split(/\s+/)
    .filter(Boolean)
    .flatMap((part) => [part[0], part.length > 1 ? part.at(-1)! : ''])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<section class="team" id="team">
  <div class="container">
    <div class="team__head" data-reveal>
      <span class="team__label">
        <span class="team__sq" aria-hidden="true"></span>
        {dict.about.teamLabel}
      </span>
      <h2 class="team__title">
        {dict.about.teamTitle}
        <svg
          class="team__arrow"
          width="34"
          height="34"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 19L5 5"></path>
          <path d="M5 15V5h10"></path>
        </svg>
      </h2>
    </div>

    <div class="team__grid">
      {
        TEAM_MEMBERS.map((member, index) => (
          <article class="team-card" data-reveal style={`--reveal-delay: ${index * 110}ms;`}>
            <div class="team-card__media">
              {hasPhoto(member.id) ? (
                <img
                  src={asset(`/assets/team/${member.id}.jpg`)}
                  alt={member.name}
                  loading="lazy"
                  decoding="async"
                  width="520"
                  height="420"
                />
              ) : (
                <div class="team-card__fallback" aria-label={member.name}>
                  <span>{initialsOf(member.name)}</span>
                </div>
              )}
            </div>
            <h3 class="team-card__name">
              <span class="team-card__role">{member.role}</span>
              {member.name}
            </h3>
            <p class="team-card__desc">{member.desc[lang]}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .team {
    padding-block: 4.5rem 0.5rem;
  }

  .team__head {
    margin-bottom: 2.75rem;
  }

  .team__label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.4rem;
  }

  .team__sq {
    width: 9px;
    height: 9px;
    background: var(--text);
  }

  .team__title {
    margin: 0;
    font-size: clamp(2rem, 5.4vw, 3.6rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    color: var(--text);
    max-width: 18ch;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .team__arrow {
    flex: none;
    color: var(--accent);
    height: auto;
    width: clamp(24px, 3.4vw, 34px);
    margin-bottom: 0.3rem;
    transform: rotate(-90deg);
    transition: transform 0.35s ease;
  }

  .team__head:hover .team__arrow {
    transform: rotate(-104deg);
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 1.5rem;
  }

  .team-card__media {
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--bg-soft);
    margin-bottom: 0.95rem;
  }

  .team-card__media img,
  .team-card__fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease, filter 0.5s ease;
  }

  .team-card:hover .team-card__media img,
  .team-card:hover .team-card__fallback {
    transform: scale(1.035);
  }

  .team-card__fallback {
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, var(--bg-alt) 0%, var(--bg-soft) 60%, var(--accent-soft) 100%);
  }

  .team-card__fallback span {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--accent);
    opacity: 0.85;
  }

  .team-card__name {
    margin: 0 0 0.4rem;
    font-size: 1.02rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text);
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .team-card__role {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.18rem 0.5rem;
  }

  .team-card__desc {
    margin: 0;
    max-width: 40ch;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .team__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 540px) {
    .team__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-card__media img,
    .team-card__fallback,
    .team__arrow {
      transition: none !important;
    }
  }
</style>
