---
/**
 * Team cards for the dedicated /team page: photo, name in caps with a role
 * badge, short bio. Photos come from public/assets/team/<id>.<any-ext>;
 * until they exist a styled fallback with initials is shown.
 */
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';
import { asset, type Lang } from '../utils/links';
import { TEAM_MEMBERS } from '../data/team';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const publicRoot = fileURLToPath(new URL('../../public', import.meta.url));

/** Finds a team photo under public/assets/team/ for any common image extension and any file casing. */
const photoFor = (id: string): string | null => {
  const dir = `${publicRoot}/assets/team`;
  if (!fs.existsSync(dir)) return null;
  const files = fs.readdirSync(dir);
  for (const ext of ['jpg', 'jpeg', 'webp', 'png', 'avif']) {
    const match = files.find((f) => f.toLowerCase() === `${id}.${ext}`);
    if (match) return `/assets/team/${match}`;
  }
  return null;
};

const initialsOf = (name: string) =>
  name
    .replace(/[^\p{L}\p{N}\s]/gu, '')
    .split(/\s+/)
    .filter(Boolean)
    .flatMap((part) => [part[0], part.length > 1 ? part.at(-1)! : ''])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<section class="section">
  <div class="container">
    <div class="team__grid">
      {
        TEAM_MEMBERS.map((member, index) => (
          <article class="team-card" data-reveal style={`--reveal-delay: ${index * 110}ms;`}>
            <div class="team-card__media">
              {photoFor(member.id) ? (
                <img
                  src={asset(photoFor(member.id)!)}
                  alt={member.name}
                  loading="lazy"
                  decoding="async"
                  width="520"
                  height="420"
                />
              ) : (
                <div class="team-card__fallback" aria-label={member.name}>
                  <span>{initialsOf(member.name)}</span>
                </div>
              )}
            </div>
            <h3 class="team-card__name">
              <span class="team-card__role">{member.role}</span>
              {member.name}
            </h3>
            <p class="team-card__desc">{member.desc[lang]}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .team__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 1.5rem;
  }

  .team-card__media {
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--bg-soft);
    margin-bottom: 0.95rem;
  }

  .team-card__media img,
  .team-card__fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease, filter 0.5s ease;
  }

  .team-card:hover .team-card__media img,
  .team-card:hover .team-card__fallback {
    transform: scale(1.035);
  }

  .team-card__fallback {
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, var(--bg-alt) 0%, var(--bg-soft) 60%, var(--accent-soft) 100%);
  }

  .team-card__fallback span {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--accent);
    opacity: 0.85;
  }

  .team-card__name {
    margin: 0 0 0.4rem;
    font-size: 1.02rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text);
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .team-card__role {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.18rem 0.5rem;
  }

  .team-card__desc {
    margin: 0;
    max-width: 40ch;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .team__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 540px) {
    .team__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-card__media img,
    .team-card__fallback {
      transition: none !important;
    }
  }
</style>
