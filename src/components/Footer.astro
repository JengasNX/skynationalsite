---
import { SITE, SOCIALS_ACTIVE } from '../config';
import { asset, pathFor, type Lang } from '../utils/links';
import { dicts } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = dicts[lang];
const year = new Date().getFullYear();

const sections = [
  { href: '/about', label: dict.nav.about },
  { href: '/news', label: dict.nav.news },
  { href: '/events', label: dict.nav.events },
  { href: '/wiki', label: dict.nav.wiki },
];

const community = [
  { href: '/vacancies', label: dict.nav.vacancies },
  { href: '/join', label: dict.nav.join },
  { href: '/contacts', label: dict.nav.contacts },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a class="logo" href={pathFor(lang, '/')} aria-label={SITE.name}>
          <img
            class="logo__img logo__img--light"
            src={asset('/assets/logo-skn.png')}
            alt=""
            width="44"
            height="44"
          />
          <img
            class="logo__img logo__img--dark"
            src={asset('/assets/logo-skn-light.png')}
            alt=""
            width="44"
            height="44"
          />
          <span class="logo__text">Sky<span>National</span></span>
        </a>
        <p>{dict.footer.tagline}</p>
        <div class="socials">
          {
            SOCIALS_ACTIVE.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <h4>{dict.footer.navTitle}</h4>
        <ul>
          {
            sections.map((item) => (
              <li>
                <a href={pathFor(lang, item.href)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4>{dict.footer.communityTitle}</h4>
        <ul>
          {
            community.map((item) => (
              <li>
                <a href={pathFor(lang, item.href)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4>{dict.footer.followTitle}</h4>
        <ul>
          <li>
            <a href={pathFor(lang, '/join')}>{dict.discord.cta}</a>
          </li>
          <li>
            <a href={pathFor(lang, '/contacts')}>{dict.nav.contacts}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>© {year} {SITE.name}. {dict.footer.rights}</span>
      <span>{dict.footer.disclaimer}</span>
    </div>
  </div>
</footer>

<style>
  /* the footer is always deep navy — force the white logo there */
  .site-footer .logo__img--light {
    display: none;
  }

  .site-footer .logo__img--dark {
    display: block;
  }
</style>
