---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../utils/links';
import { dicts, formatDateTime } from '../i18n';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'events'>;
}

const { lang, entry } = Astro.props;
const dict = dicts[lang];
const { title, date, timezone, type, route, network, link, excerpt } = entry.data;

const day = new Intl.DateTimeFormat('en-GB', { timeZone: 'UTC', day: '2-digit' }).format(date);
const month = new Intl.DateTimeFormat(lang === 'ru' ? 'ru-RU' : 'en-GB', {
  timeZone: 'UTC',
  month: 'short',
})
  .format(date)
  .replace('.', '');
const year = new Intl.DateTimeFormat('en-GB', { timeZone: 'UTC', year: 'numeric' }).format(date);
---

<article class="card event-card" data-reveal>
  <div class="event-card__date" aria-hidden="true">
    <span class="event-card__day">{day}</span>
    <span class="event-card__month">{month}</span>
    <span class="event-card__year">{year}</span>
  </div>
  <div class="event-card__body">
    <div class="meta">
      <span class="chip chip--accent">{dict.eventType[type]}</span>
      <time datetime={date.toISOString()}>{formatDateTime(date, lang, timezone)}</time>
    </div>
    <h3>{title}</h3>
    <p class="card__excerpt">{excerpt}</p>
    <ul class="event-facts">
      <li><b>{dict.events.time}</b> {formatDateTime(date, lang, timezone)}</li>
      {route && <li><b>{dict.events.route}</b> <span class="mono">{route}</span></li>}
      {network && <li><b>{dict.events.network}</b> {network}</li>}
    </ul>
    {
      link ? (
        <p>
          <a class="link-arrow" href={link} target="_blank" rel="noopener noreferrer">
            {dict.events.details}
          </a>
        </p>
      ) : null
    }
  </div>
</article>
