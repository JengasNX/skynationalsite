---
import Icon from './Icon.astro';
import type { Lang } from '../utils/links';
import { dicts } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = dicts[lang];
---

<dialog
  class="search-dialog"
  id="site-search"
  aria-label={dict.search.title}
  data-type-page={dict.search.types.page}
  data-type-news={dict.search.types.news}
  data-type-event={dict.search.types.event}
  data-type-wiki={dict.search.types.wiki}
>
  <div class="search-panel">
    <div class="search-panel__head">
      <Icon name="search" size={18} />
      <input
        type="search"
        id="search-input"
        placeholder={dict.search.placeholder}
        autocomplete="off"
        aria-label={dict.search.title}
        aria-controls="search-results"
      />
      <button class="icon-btn" type="button" data-search-close aria-label={dict.nav.close}>
        <Icon name="close" size={16} />
      </button>
    </div>

    <ul class="search-results" id="search-results"></ul>
    <p class="search-empty" id="search-empty" hidden>{dict.search.noResults}</p>

    <div class="search-panel__foot">
      <span>{dict.search.hint}</span>
      <span data-search-total></span>
    </div>
  </div>
</dialog>

<script>
  import MiniSearch from 'minisearch';

  type Doc = {
    id: string;
    lang: string;
    type: 'page' | 'news' | 'event' | 'wiki';
    title: string;
    excerpt: string;
    url: string;
    body?: string;
  };

  const dlg = document.getElementById('site-search') as HTMLDialogElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const list = document.getElementById('search-results') as HTMLUListElement;
  const empty = document.getElementById('search-empty') as HTMLParagraphElement;
  const total = document.querySelector<HTMLElement>('[data-search-total]');
  const rawBase = document.documentElement.dataset.base ?? '/';
  const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
  const lang = document.documentElement.lang || 'ru';

  let docs: Doc[] = [];
  let engine: MiniSearch<Doc> | null = null;
  let activeIndex = -1;

  const typeLabels: Record<Doc['type'], string> = {
    page: dlg.dataset.typePage ?? '',
    news: dlg.dataset.typeNews ?? '',
    event: dlg.dataset.typeEvent ?? '',
    wiki: dlg.dataset.typeWiki ?? '',
  };

  async function ensureIndex() {
    if (engine) return;
    try {
      const res = await fetch(`${base}search-index.json`);
      const all: Doc[] = await res.json();
      docs = all.filter((d) => d.lang === lang);
      engine = new MiniSearch<Doc>({
        fields: ['title', 'excerpt', 'body'],
        storeFields: ['title', 'excerpt', 'url', 'type'],
        searchOptions: {
          boost: { title: 4, excerpt: 2 },
          prefix: true,
          fuzzy: 0.25,
        },
      });
      engine.addAll(docs);
    } catch (error) {
      console.warn('search index unavailable', error);
      engine = null;
    }
  }

  function render(results: { id: string }[], query: string) {
    list.innerHTML = '';
    activeIndex = -1;
    if (!query.trim()) {
      empty.hidden = true;
      if (total) total.textContent = '';
      return;
    }
    const items = results.slice(0, 8);
    empty.hidden = items.length > 0;
    if (total) total.textContent = String(items.length);

    items.forEach((r) => {
      const doc = docs.find((d) => d.id === r.id);
      if (!doc) return;
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = doc.url;
      a.innerHTML =
        `<span class="sr-type">${typeLabels[doc.type] ?? ''}</span>` +
        `<span class="sr-title"></span>` +
        `<span class="sr-excerpt"></span>`;
      (a.querySelector('.sr-title') as HTMLElement).textContent = doc.title;
      (a.querySelector('.sr-excerpt') as HTMLElement).textContent = doc.excerpt;
      li.appendChild(a);
      list.appendChild(li);
    });
  }

  function search(query: string) {
    if (!query.trim()) return render([], '');
    if (!engine) return render([], query);
    render(engine.search(query), query);
  }

  async function open() {
    if (!dlg.open) dlg.showModal();
    input.focus();
    await ensureIndex();
    search(input.value);
  }

  document.querySelectorAll<HTMLElement>('[data-search-open]').forEach((btn) => {
    btn.addEventListener('click', () => void open());
  });

  document.querySelector('[data-search-close]')?.addEventListener('click', () => dlg.close());

  dlg.addEventListener('click', (event) => {
    if (event.target === dlg) dlg.close();
  });

  input.addEventListener('input', () => search(input.value));

  document.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      if (dlg.open) dlg.close();
      else void open();
      return;
    }
    if (!dlg.open) return;

    const links = Array.from(list.querySelectorAll<HTMLAnchorElement>('a'));
    if (event.key === 'ArrowDown' && links.length) {
      event.preventDefault();
      activeIndex = Math.min(activeIndex + 1, links.length - 1);
    } else if (event.key === 'ArrowUp' && links.length) {
      event.preventDefault();
      activeIndex = Math.max(activeIndex - 1, 0);
    } else if (event.key === 'Enter' && activeIndex >= 0 && links[activeIndex]) {
      event.preventDefault();
      links[activeIndex].click();
      return;
    } else {
      return;
    }
    links.forEach((l, i) => l.classList.toggle('is-active', i === activeIndex));
    links[activeIndex]?.scrollIntoView({ block: 'nearest' });
  });
</script>
