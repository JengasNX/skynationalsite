---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import CookieBanner from '../components/CookieBanner.astro';
import PageLoader from '../components/PageLoader.astro';
import { SITE, ANALYTICS } from '../config';
import { asset, localePath, type Lang } from '../utils/links';
import { dicts } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  pagePath: string;
  description?: string;
  image?: string;
}

const { lang, title, pagePath, description = SITE.description[lang], image = '/assets/og-image.jpg' } =
  Astro.props;

const dict = dicts[lang];
const isHome = title === SITE.name;
const documentTitle = isHome ? `${SITE.name} · ${SITE.tagline[lang]}` : `${title} · ${SITE.name}`;

const canonical = `${SITE.url}${localePath(lang, pagePath)}`;
const altRu = `${SITE.url}${localePath('ru', pagePath)}`;
const altEn = `${SITE.url}${localePath('en', pagePath)}`;
const ogImage = `${SITE.url}${image.startsWith('/') ? image : `/${image}`}`;
---

<!doctype html>
<html lang={lang} data-theme="light" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={altRu} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altRu} />
    <link rel="icon" href={asset('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" href={asset('/assets/favicon.png')} />
    <link rel="apple-touch-icon" href={asset('/assets/apple-touch-icon.png')} />
    <link rel="manifest" href={asset('/site.webmanifest')} />
    <meta name="theme-color" content="#0a1530" />
    <link rel="preload" as="font" type="font/woff2" href={asset(`/assets/fonts/Onest-${lang === 'ru' ? 'cyrillic' : 'latin'}.woff2`)} crossorigin="anonymous" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ru' ? 'en_US' : 'ru_RU'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('skn-theme');
          if (t !== 'dark' && t !== 'light') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
        document.documentElement.classList.add('js');
        document.documentElement.classList.add('is-loading');
      })();
    </script>

    <script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
      (function () {
        try {
          var saved = localStorage.getItem('skn-lang');
          if (saved !== 'en' && saved !== 'ru') return;
          var p = location.pathname;
          if (p.indexOf(base) === 0) p = p.slice(base.length);
          var isEn = /^\/?en(\/|$)/.test(p);
          if (saved === 'en' && !isEn) {
            location.replace(base.replace(/\/$/, '') + '/en' + (p === '/' ? '/' : p) + location.search);
          } else if (saved === 'ru' && isEn) {
            var stripped = p.replace(/^\/?en/, '') || '/';
            location.replace(base.replace(/\/$/, '') + (stripped === '/' ? '/' : stripped) + location.search);
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <PageLoader text={dict.loader.text} />
    <a class="skip-link" href="#main">{dict.a11y.skip}</a>
    <Header lang={lang} pagePath={pagePath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <SearchDialog lang={lang} />
    <CookieBanner lang={lang} />

    {ANALYTICS.provider && ANALYTICS.id && (
      <script is:inline define:vars={{ provider: ANALYTICS.provider, id: ANALYTICS.id }}>
        // Аналитика по согласию: согласие сохраняет cookie-баннер в localStorage.
        function loadAnalytics() {
          if (window.__sknAnalyticsLoaded) return;
          window.__sknAnalyticsLoaded = true;
          if (provider === 'ga4') {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
            document.head.appendChild(s);
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', id, { anonymize_ip: true });
          } else if (provider === 'plausible') {
            var s2 = document.createElement('script');
            s2.defer = true;
            s2.dataset.domain = id;
            s2.src = 'https://plausible.io/js/script.js';
            document.head.appendChild(s2);
          }
        }
        try {
          var consent = localStorage.getItem('skn-cookie-consent');
          if (consent === 'accept') loadAnalytics();
          window.addEventListener('skn:analytics-consent', loadAnalytics);
        } catch (e) {}
      </script>
    )}

    <script>
      // Theme, language, mobile nav, reveal-on-scroll and hero parallax.
      const root = document.documentElement;

      // Hide the page loader shortly after full load. The intro loader plays
      // on EVERY page load/navigation (owner's preference). Min display ~900ms,
      // max 2.5s so a slow network never traps visitors on the overlay.
      {
        const loader = document.getElementById('page-loader');
        if (loader) {
          const start = Date.now();
          let hidden = false;
          const hide = () => {
            if (hidden) return;
            hidden = true;
            loader.classList.add('page-loader--hidden');
            root.classList.remove('is-loading');
            window.setTimeout(() => loader.remove(), 600);
          };
          window.addEventListener('load', () => {
            window.setTimeout(hide, Math.max(0, 900 - (Date.now() - start)));
          });
          window.setTimeout(hide, 2500);
        }
      }

      const setTheme = (next: 'light' | 'dark') => {
        root.dataset.theme = next;
        try {
          localStorage.setItem('skn-theme', next);
        } catch {}
        document
          .querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')
          .forEach((b) => (b.dataset.state = next));
      };

      document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
        btn.dataset.state = root.dataset.theme as string;
        btn.addEventListener('click', () => setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark'));
      });

      document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((a) => {
        a.addEventListener('click', () => {
          try {
            localStorage.setItem('skn-lang', a.dataset.langLink as string);
          } catch {}
        });
        // Animated language switch when the browser cannot do it natively.
        // With View Transitions supported, the cross-document cross-fade
        // kicks in automatically and we don't touch the navigation.
        a.addEventListener('click', (event) => {
          if (document.startViewTransition) return;
          event.preventDefault();
          root.classList.add('lang-leaving');
          window.setTimeout(() => {
            window.location.href = a.href;
          }, 200);
        });
      });

      const nav = document.getElementById('site-nav');
      const navToggle = document.getElementById('nav-toggle');
      navToggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('is-open');
        navToggle.setAttribute('aria-expanded', String(Boolean(open)));
      });

      // Reveal on scroll
      const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window && revealItems.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        revealItems.forEach((el, i) => {
          if (!el.style.getPropertyValue('--reveal-delay')) {
            el.style.setProperty('--reveal-delay', `${Math.min(i % 4, 3) * 80}ms`);
          }
          io.observe(el);
        });
      } else {
        revealItems.forEach((el) => el.classList.add('is-visible'));
      }

      // Hero parallax
      const heroImg = document.querySelector<HTMLImageElement>('.hero__media img');
      if (heroImg && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            const y = Math.min(window.scrollY, 900);
            heroImg.style.transform = `translate3d(0, ${y * 0.16}px, 0) scale(1.02)`;
            ticking = false;
          });
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // Event countdowns
      document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((box) => {
        const target = new Date(box.dataset.countdown as string).getTime();
        const parts = {
          days: box.querySelector('[data-unit="days"]'),
          hours: box.querySelector('[data-unit="hours"]'),
          minutes: box.querySelector('[data-unit="minutes"]'),
          seconds: box.querySelector('[data-unit="seconds"]'),
        };
        const pad = (n: number) => String(n).padStart(2, '0');
        const tick = () => {
          const diff = Math.max(0, target - Date.now());
          const d = Math.floor(diff / 86400000);
          const h = Math.floor((diff % 86400000) / 3600000);
          const m = Math.floor((diff % 3600000) / 60000);
          const s = Math.floor((diff % 60000) / 1000);
          if (parts.days) parts.days.textContent = String(d);
          if (parts.hours) parts.hours.textContent = pad(h);
          if (parts.minutes) parts.minutes.textContent = pad(m);
          if (parts.seconds) parts.seconds.textContent = pad(s);
          if (diff === 0) window.clearInterval(timer);
        };
        const timer = window.setInterval(tick, 1000);
        tick();
      });
    </script>
  </body>
</html>
